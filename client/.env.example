# Leave empty in dev (Vite proxies /api to localhost:5000). In production set to your API origin, e.g. https://api.example.com
VITE_API_URL=
# Google Maps JavaScript API key (enable "Maps JavaScript API"; optionally "Geocoding API" for address lookup)
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID from Google Cloud console (needed for Advanced Markers styling)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# How often (seconds) the field visitor app records GPS while a shift is active
VITE_GPS_PING_SECONDS=60
