generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  FIELD_VISITOR
}

enum VisitStatus {
  OPEN
  FOLLOW_UP
  DEAL_DONE
  LEAVE_OUT
}

enum LeadSource {
  FIELD_VISIT
  IMPORT
  MANUAL
}

/// How an incentive rule pays out
enum IncentiveType {
  /// ₹ rate for every qualifying deal
  PER_DEAL
  /// rate % of the plan amount
  PERCENT_OF_AMOUNT
  /// ₹ rate for every `every` deals (e.g. 10 deals → ₹1000)
  PER_DEAL_COUNT
  /// ₹ rate for every ₹`every` of plan amount (e.g. every ₹1000 → ₹100)
  PER_AMOUNT_SLAB
  /// one-time ₹ rate when deals in the month reach `every`
  DEAL_TARGET_BONUS
  /// one-time ₹ rate when plan amount in the month reaches ₹`every`
  REVENUE_TARGET_BONUS
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(FIELD_VISITOR)
  phone         String?
  employeeCode  String?   @unique
  state         String?
  district      String?
  bikeName      String?
  bikeMileage   Float?
  dlNumber      String?
  dlPhotoUrl    String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  /// Reporting manager (for FIELD_VISITOR employees)
  managerId     String?
  manager       User?     @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]    @relation("ReportsTo")
  /// Team led by this user (for MANAGER)
  managedTeam   Team?     @relation("TeamManager")
  plansCreated  Plan[]    @relation("PlanCreatedBy")
  zoneId        String?
  zone          Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  shifts        Shift[]
  visits        Visit[]   @relation("VisitOwner")
  visitsCreated Visit[]   @relation("VisitCreatedBy")
  payouts       IncentivePayout[] @relation("PayoutUser")
  payoutsMade   IncentivePayout[] @relation("PayoutPaidBy")
  placesAdded   Place[]   @relation("PlaceCreatedBy")
  pings         LocationPing[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role, isActive])
  @@index([managerId])
  @@index([zoneId])
}

model Zone {
  id           String   @id @default(cuid())
  name         String
  state        String
  district     String
  focusSegment String?
  users        User[]
  teams        Team[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, state, district])
}

model Team {
  id            String   @id @default(cuid())
  name          String   @unique
  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  visitsTarget  Int      @default(0)
  dealsTarget   Int      @default(0)
  revenueTarget Decimal  @default(0) @db.Decimal(14, 2)
  managerId     String?  @unique
  manager       User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Shift {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local business date (YYYY-MM-DD) in APP_TIMEZONE
  date         String
  status       ShiftStatus @default(ACTIVE)
  startTime    DateTime    @default(now())
  startKm      Float
  startLat     Float?
  startLng     Float?
  startAddress String?
  /// Odometer photo at punch-in (Cloudflare R2 URL or /uploads path)
  startPhotoUrl String?
  endTime      DateTime?
  endKm        Float?
  endLat       Float?
  endLng       Float?
  endAddress   String?
  /// Odometer photo at punch-out
  endPhotoUrl  String?
  distanceKm   Float?
  fuelRate     Decimal?    @db.Decimal(8, 2)
  allowance    Decimal?    @db.Decimal(12, 2)
  visits       Visit[]
  pings        LocationPing[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

model Visit {
  id            String           @id @default(cuid())
  /// Owner of the lead / visit (field employee or manager) – gets the incentive credit
  userId        String
  user          User             @relation("VisitOwner", fields: [userId], references: [id], onDelete: Cascade)
  source        LeadSource       @default(FIELD_VISIT)
  createdById   String?
  createdBy     User?            @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// When the visit became DEAL_DONE – incentives are counted by this date
  dealClosedAt  DateTime?
  /// Place from the shared places database (auto-linked by phone when possible)
  placeId       String?
  place         Place?           @relation(fields: [placeId], references: [id], onDelete: SetNull)
  shiftId       String?
  shift         Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Product name snapshot (kept even if the product is renamed/removed)
  product       String
  productId     String?
  productRef    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Subscription sold (for DEAL_DONE) – snapshots keep history stable
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName        String?
  billingCycle    BillingCycle?
  nextPaymentDate DateTime?
  companyName   String
  contactPerson String?
  phone         String
  email         String?
  status        VisitStatus      @default(OPEN)
  address       String
  lat           Float?
  lng           Float?
  odometerKm    Float?
  /// Plan amount agreed with the client
  dealValue     Decimal?         @db.Decimal(14, 2)
  nextFollowUp  DateTime?
  notes         String?
  adminNote     String?
  visitedAt     DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, visitedAt])
  @@index([status])
  @@index([visitedAt])
  @@index([nextFollowUp])
  @@index([categoryId])
  @@index([nextPaymentDate])
  @@index([status, dealClosedAt])
  @@index([source])
  @@index([placeId])
}

model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([shiftId, recordedAt])
  @@index([userId, recordedAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Business categories shown in the visit form (managed by Admin in Settings)
model Category {
  id               String   @id @default(cuid())
  name             String   @unique
  defaultProductId String?
  defaultProduct   Product? @relation("CategoryDefaultProduct", fields: [defaultProductId], references: [id], onDelete: SetNull)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  visits           Visit[]
  incentiveRules   IncentiveRule[]
  places           Place[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Software products pitched (managed by Admin in Settings)
model Product {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  plans       Plan[]
  categories  Category[] @relation("CategoryDefaultProduct")
  visits      Visit[]
  incentiveRules IncentiveRule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// Subscription plans with price (managed by Admin and Managers in Settings)
model Plan {
  id           String       @id @default(cuid())
  name         String
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  price        Decimal      @db.Decimal(14, 2)
  billingCycle BillingCycle @default(MONTHLY)
  description  String?
  isActive     Boolean      @default(true)
  createdById  String?
  createdBy    User?        @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  visits       Visit[]
  incentiveRules IncentiveRule[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, productId])
  @@index([productId, isActive])
}

/// Incentive rules – managed by Admin only. Calculated per calendar month on DEAL_DONE visits.
model IncentiveRule {
  id            String        @id @default(cuid())
  name          String
  description   String?
  /// FIELD_VISITOR → own deals · MANAGER → team deals (own + reporting employees)
  appliesTo     Role          @default(FIELD_VISITOR)
  type          IncentiveType @default(PER_DEAL)
  /// ₹ amount, or % for PERCENT_OF_AMOUNT
  rate          Decimal       @db.Decimal(14, 2)
  /// deal count or ₹ amount for slab / target types
  every         Decimal?      @db.Decimal(14, 2)
  /// rule pays only when the month has at least this many qualifying deals
  minDeals      Int?
  /// cap per person per month
  maxPayout     Decimal?      @db.Decimal(14, 2)
  /// optional filters – null means "all"
  planId        String?
  plan          Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// YYYY-MM-DD validity window (inclusive), null = open
  effectiveFrom String?
  effectiveTo   String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, appliesTo])
}

/// Monthly incentive payout recorded by Admin
model IncentivePayout {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("PayoutUser", fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month      String
  /// amount actually paid (may include manual adjustment)
  amount     Decimal  @db.Decimal(14, 2)
  /// system-calculated amount at the time of payment
  calculated Decimal  @db.Decimal(14, 2)
  note       String?
  paidAt     DateTime @default(now())
  paidById   String?
  paidBy     User?    @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@unique([userId, month])
  @@index([month])
}

/// Shared database of businesses to visit (hotels, restaurants, garages, schools…).
/// Added by Admin / Managers, searched by everyone by area + category, with visited status.
model Place {
  id            String    @id @default(cuid())
  name          String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Locality / area, e.g. "Vidyaranyapura"
  area          String?
  city          String?
  pincode       String?
  address       String?
  phone         String?
  contactPerson String?
  lat           Float?
  lng           Float?
  notes         String?
  isActive      Boolean   @default(true)
  createdById   String?
  createdBy     User?     @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  visits        Visit[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, area])
  @@index([categoryId])
  @@index([name])
  @@index([pincode])
  @@index([lat, lng])
}
